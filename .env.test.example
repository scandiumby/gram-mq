# Copy to .env.test (gitignored). The contract suite reads it through the
# TestDatabase settings; tests never read the deploy .env (Constitution,
# Testing). This example carries placeholders only, no secrets.

# Optional: without it the postgres parameterization is silently skipped.
# Real env vars (GRAMMQ_TEST_DATABASE_URL, or the CI alias
# TEST_DATABASE_URL) override this file.
GRAMMQ_TEST_DATABASE_URL=postgresql+asyncpg://gram:CHANGE_ME@localhost:5432/gram_mq_test

# How the suite finds this very file: the real environment variable
# GRAMMQ_TEST_ENV_FILE; local fallback: ./.env.test — this file itself.
