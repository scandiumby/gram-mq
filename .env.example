# Copy to .env (local) or /etc/gram-mq/.env (production, pointed to by
# GRAMMQ_ENV_FILE). The real env-file is gitignored and never deployed;
# this example carries placeholders only, no secrets.

# Required. Secret: never committed, never defaulted; a missing value
# aborts the process at startup (fail-fast).
GRAMMQ_DATABASE_URL=postgresql+asyncpg://gram:CHANGE_ME@localhost:5432/gram_mq

# Optional; defaults are versioned in src/gram_mq/settings.py.
#GRAMMQ_BROKER_LEASE_SECONDS=60
#GRAMMQ_BROKER_MAX_ATTEMPTS=20
#GRAMMQ_WORKER_POLL_INTERVAL=1.0
#GRAMMQ_WORKER_BACKOFF_BASE_SECONDS=5.0

# Where bot token files live and the worker reads them back; in
# containers point it at persistent storage (/data/bots). The files hold
# the ENCRYPTED file half of the token (spec 006), never plaintext.
#GRAMMQ_BOTS_DIR=./bots

# Inbound API listen address/port; containers need 0.0.0.0, and the port
# must match the platform's expected container port.
#GRAMMQ_API_HOST=127.0.0.1
#GRAMMQ_API_PORT=8080

# Prefix of all DB table/index names (default gmq, e.g. gmq_messages).
# Fixed when the first migration is applied — changing it on an existing
# database is not supported; override before `alembic upgrade head`.
#GRAMMQ_TABLE_PREFIX=gmq

# Two-stage API key bootstrap for shell-less deploys (spec 005). The
# activation endpoint POST /bootstrap/api-key exists only while the flag
# is on (default false). Window: `uv run gram-mq key prepare` locally ->
# put its "Значение активации" line into GRAMMQ_KEY_BOOTSTRAP_MATERIAL ->
# enable the flag -> redeploy -> POST once (201; repeats give 409) ->
# disable the flag -> redeploy. The material is a secret (prefix:hash,
# no plaintext); the activated key lives in the DB and keeps working
# after the flag goes off.
#GRAMMQ_KEY_BOOTSTRAP_ENABLED=false
#GRAMMQ_KEY_BOOTSTRAP_MATERIAL=

# Bot management window + encrypted split token storage (spec 006).
# GRAMMQ_TOKEN_MASTER_KEY is permanent: hex of 32 random bytes
# (python -c "import os; print(os.urandom(32).hex())"). Both encrypted
# token halves (file + DB row) live under this key; LOSING it makes every
# encrypted bot permanently "not ready" — recovery is re-issuing tokens
# in BotFather. It is a secret, has no default, and is shared by no
# other purpose.
#GRAMMQ_TOKEN_MASTER_KEY=
#
# The bot bootstrap endpoints POST /bootstrap/bots (creation) and
# DELETE /bootstrap/bots/{slug} (revocation) exist only while the flag is
# on (default false). Window: put the FULL bot token from BotFather into
# GRAMMQ_BOT_BOOTSTRAP_TOKEN -> enable the flag -> redeploy -> POST
# {"name": "..."} once (201 + the generated bot_slug; repeats with the
# same token give 409) -> disable the flag AND CLEAR the token setting ->
# redeploy. The full token lives in the panel's secret store only while
# the setting is set — closing the window is part of the procedure.
#GRAMMQ_BOT_BOOTSTRAP_ENABLED=false
#GRAMMQ_BOT_BOOTSTRAP_TOKEN=

# Inbound webhook flow (spec 007): Telegram updates arrive at
# POST /webhooks/{bot_slug} authenticated by a per-bot secret that only
# `gram-mq webhook set` ever sees (it generates the secret, hands it to
# Telegram's set_webhook, and stores an HMAC-SHA256 check value).
#
# GRAMMQ_WEBHOOK_MASTER_KEY is permanent: hex of 32 random bytes, a
# secret with no default, dedicated to webhook check values (never
# shared with GRAMMQ_TOKEN_MASTER_KEY). LOSING it means every webhook
# answers 401 until each bot is re-registered with `gram-mq webhook
# set`. Unset on an outbound-only deploy: the webhook routes stay off.
#GRAMMQ_WEBHOOK_MASTER_KEY=
#
# Public base URL of THIS deployment as Telegram sees it (TLS
# termination is your infrastructure); required by `gram-mq webhook
# set`, e.g. https://gram.example.com
#GRAMMQ_WEBHOOK_PUBLIC_URL=
#
# Where the inbound worker POSTs updates verbatim (the unstable bot
# server). Setting it is also the single-container launcher's signal to
# start the third service; unset = inbound worker does not run. The
# receiver must answer 2xx only after processing and dedup by
# (bot, update_id) with a sliding window.
#GRAMMQ_INBOUND_DELIVERY_URL=
#
# Optional auth header for delivery requests; the value is a secret.
#GRAMMQ_INBOUND_DELIVERY_AUTH_HEADER_NAME=Authorization
#GRAMMQ_INBOUND_DELIVERY_AUTH_HEADER_VALUE=
#GRAMMQ_INBOUND_DELIVERY_TIMEOUT_SECONDS=10.0

# How the process finds this very file: the real environment variable
# GRAMMQ_ENV_FILE (production: the single Environment= line of the systemd
# unit, e.g. /etc/gram-mq/.env). Local fallback: ./.env — this file itself.
# Real environment variables always override values from this file.

# Tests never read this file (Constitution, Testing). Their optional
# Postgres URL lives in ./.env.test as GRAMMQ_TEST_DATABASE_URL (template:
# .env.test.example), or in the GRAMMQ_TEST_DATABASE_URL /
# TEST_DATABASE_URL environment variable.
