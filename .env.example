# Copy to .env (local) or /etc/gram-mq/.env (production, pointed to by
# GRAMMQ_ENV_FILE). The real env-file is gitignored and never deployed;
# this example carries placeholders only, no secrets.

# Required. Secret: never committed, never defaulted; a missing value
# aborts the process at startup (fail-fast).
GRAMMQ_DATABASE_URL=postgresql+asyncpg://gram:CHANGE_ME@localhost:5432/gram_mq

# Optional; defaults are versioned in src/gram_mq/settings.py.
#GRAMMQ_BROKER_LEASE_SECONDS=60
#GRAMMQ_BROKER_MAX_ATTEMPTS=5

# Prefix of all DB table/index names (default gmq, e.g. gmq_messages).
# Fixed when the first migration is applied — changing it on an existing
# database is not supported; override before `alembic upgrade head`.
#GRAMMQ_TABLE_PREFIX=gmq

# How the process finds this very file: the real environment variable
# GRAMMQ_ENV_FILE (production: the single Environment= line of the systemd
# unit, e.g. /etc/gram-mq/.env). Local fallback: ./.env — this file itself.
# Real environment variables always override values from this file.

# Tests never read this file (Constitution, Testing). Their optional
# Postgres URL lives in ./.env.test as GRAMMQ_TEST_DATABASE_URL (template:
# .env.test.example), or in the GRAMMQ_TEST_DATABASE_URL /
# TEST_DATABASE_URL environment variable.
